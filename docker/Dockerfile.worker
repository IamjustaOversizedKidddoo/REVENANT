# REVENANT — Autonomous Execution Worker Dockerfile
# Headless autonomous agent swarm engine with security assessment toolchain
FROM python:3.11-slim as base

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PYTHONPATH=/app:/app/control-plane

WORKDIR /app

# Install native security tools, system dependencies, and network diagnostic tools
RUN apt-get update && apt-get install -y --no-install-recommends \
    curl \
    git \
    nmap \
    yara \
    iproute2 \
    ca-certificates \
    && rm -rf /var/lib/apt/lists/*

# Create application user with appropriate workspace permissions
RUN groupadd -g 10001 revenant && \
    useradd -u 10001 -g revenant -s /bin/bash -m revenant

# Copy project definition and install Python dependencies
COPY pyproject.toml /app/
RUN pip install --no-cache-dir --upgrade pip && \
    pip install --no-cache-dir \
    pydantic>=2.6.0 \
    pyyaml>=6.0.1 \
    requests>=2.31.0 \
    httpx>=0.27.0

# Copy application source code and configurations
COPY control-plane /app/control-plane
COPY orchestrator /app/orchestrator
COPY adapters /app/adapters
COPY reporting /app/reporting
COPY configs /app/configs
COPY wordlists /app/wordlists
COPY revenant.py /app/

# Create runtime directories for evidence and output persistence
RUN mkdir -p /app/evidence /app/evidence_remediation /app/data && \
    chown -R revenant:revenant /app

USER revenant

VOLUME ["/app/evidence", "/app/data"]

ENTRYPOINT ["python", "revenant.py"]
CMD ["asm", "daemon", "--interval", "300"]
