        "parameters": [
          {
            "name": "campaign_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Campaign Id"
            }
          },
          {
            "name": "format",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "pattern": "^(markdown|html|sarif|json|faraday|dradis)$",
              "description": "Desired export format",
              "default": "markdown",
              "title": "Format"
            },
