# REVENANT Platform — Production Environment Variables
# Copy to .env and configure before deployment: cp deployments/.env.example deployments/.env

# --- Platform Core ---
REVENANT_ENV=production
REVENANT_LOG_LEVEL=INFO
REVENANT_SECRET_KEY=change-this-to-a-secure-random-32-byte-hex-string

# --- Database & Cache ---
POSTGRES_USER=revenant
POSTGRES_PASSWORD=generate-a-strong-password-here
POSTGRES_DB=revenant
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

REDIS_HOST=redis
REDIS_PORT=6379

# --- Control Plane API ---
API_HOST=0.0.0.0
API_PORT=8000
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# --- SOAR & Alerting Webhooks ---
SOAR_WEBHOOK_URL=https://soar.internal.corp/api/v1/webhook
SOAR_WEBHOOK_SECRET=revenant-hmac-shared-secret
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/T000/B000/XXXX

# --- Autonomous Operation Tuning ---
DEFAULT_MAX_ITERATIONS=25
ASM_POLL_INTERVAL=300
STRICT_SCOPE_REQUIRED=true
