    {
      "id": "af19f0e8-0c40-4819-9141-43e5a498adab",
      "title": "Active Directory: Insecure Unconstrained Delegation on Workload (WS-DEV01.REVENANT.LOCAL)",
      "description": "Host or service account 'WS-DEV01.REVENANT.LOCAL' is configured with Unconstrained Delegation (TRUSTED_FOR_DELEGATION). Whenever any domain user or administrator authenticates to this host, their Ticket-Granting Ticket (TGT) is stored in memory and can be harvested.",
      "severity": "CRITICAL",
      "target": "tests/fixtures/ad_identity",
      "tool": "bloodhound",
      "cve": null,
      "cwe": "CWE-269",
      "cvss_score": null,
      "mitre_attack_ids": [
        "T1558.001"
      ],
      "owasp_category": "A01:2021 - Broken Access Control",
      "endpoint": "REVENANT.LOCAL/WS-DEV01.REVENANT.LOCAL",
      "code_location": null,
      "secret_type": null,
      "reproduction_steps": "# Inspect Kerberos delegation flags on WS-DEV01.REVENANT.LOCAL:\nGet-ADComputer -Identity WS-DEV01.REVENANT.LOCAL -Properties TrustedForDelegation",
      "evidence": "Object: WS-DEV01.REVENANT.LOCAL\nTrustedForDelegation: True\nis_dc: False",
      "request_proof": null,
      "response_proof": null,
      "remediation": "Configure Resource-Based Constrained Delegation (RBCD) or Kerberos Constrained Delegation (KCD). Ensure high-privilege administrative accounts are marked 'Account is sensitive and cannot be delegated'.",
      "raw_data": {
        "account": "WS-DEV01.REVENANT.LOCAL",
        "rule": "unconstrained-delegation",
        "source_file": "bloodhound_computers.json"
      },
      "discovered_at": "2026-09-17T12:48:19.172557Z",
